# Database — use SQLite locally, PostgreSQL on AWS (RDS)
DATABASE_URL=sqlite:///./smart_study_agent.db
# DATABASE_URL=postgresql://postgres:yourpassword@your-rds-endpoint:5432/smart_study_agent

# AI Provider (groq / openai / gemini)
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
# OPENAI_API_KEY=sk-your-key-here
# GEMINI_API_KEY=your-gemini-key-here
AI_MODEL=openai/gpt-oss-120b

# CORS — allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# SMTP Email (optional — leave empty to disable email alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# JWT Secret — change this to a random string in production!
SECRET_KEY=change-this-to-random-secret
